# Copy to .env and edit for your host:
#   cp .env.example .env

# Benchmark matrix (per-engine serve blocks + GuideLLM scenarios)
MATRIX=configs/benchmark_matrix.yaml

# GuideLLM binary and target (optional overrides)
GUIDELLM=/workspace/vllm_bench/.venv/bin/guidellm
BENCHMARK_TARGET=http://127.0.0.1:8001
# VLLM_TARGET is a legacy alias for BENCHMARK_TARGET
# VLLM_TARGET=http://127.0.0.1:8001

# Engine is set automatically by serve scripts via configs/.active_engine.
# Workflow: configs/vllm_serve.sh (or sglang/trtllm) then scripts/run_benchmark.sh

HF_TOKEN=

# Cloud provider fallback (for RunPod, Vast.ai, etc. when metadata auto-detect fails)
# CLOUD_PROVIDER=runpod
# CLOUD_REGION=US-CA-1
# CLOUD_INSTANCE_TYPE=RTX_4090
# CLOUD_INSTANCE_ID=
# CLOUD_AVAILABILITY_ZONE=
